// 模块自带配置入口（让模块在任意目录下单独运行都能加载自身配置）
//
// ⚠ 本文件只属于【模块目录】。切勿用流程级的 pipeline/nextflow.config 覆盖它——
//   流程级 config 里的 includeConfig 'modules/metaspades/config' 是从 pipeline/ 出发的相对路径，
//   搬进本目录后会被解析成 modules/metaspades/modules/metaspades/config（不存在），报 Invalid include source。
//   判断方法：本文件只有一行 includeConfig 'config'；若出现 'modules/...' 或 'pipeline.generated.config'，
//   说明被覆盖错了。
//
// Nextflow 加载 nextflow.config 的顺序：启动目录 → 脚本所在目录 → $HOME/.nextflow/config
// 本文件位于模块目录，模块单独运行时（nextflow run modules/<name>/main.nf）
// 会被自动加载，从而 includeConfig 本模块的 config（软件环境 + 默认资源）。
//
// 相对路径按【包含它的文件所在目录】解析，故此处 'config' 即 modules/<name>/config。
includeConfig 'config'

// —— 调度 profile ——
// 与流程级 nextflow.config 的 profiles 保持一致；模块单独运行（nextflow run modules/<name>/main.nf
// -profile sge）时也能识别 -profile，否则报 "Unknown configuration profile: 'sge'"。
profiles {
    sge   { process.executor = 'sge' }
    k8s   { process.executor = 'k8s' }
    local { process.executor = 'local' }

    // —— 容器引擎（按需叠加，逗号组合：-profile sge,singularity）——
    // config 里的 container 指令只是声明镜像；不开引擎时任务直接在宿主机执行。
    // autoMounts=true 自动把输入文件所在路径 bind 进容器，无需手写 --bind 数据目录。
    // 使用前提：把 metaspades.sif 放到 ${projectDir}/sif/ 下，或 --sif_dir 指向镜像所在目录。
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    docker {
        docker.enabled = true
    }
}

// —— 运行报告（模块单独跑时也落盘一份任务级明细）——
// workdir 列是排查错误的关键：失败任务的 .command.err / .command.out 都在该目录下
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,native_id,name,status,exit,realtime,peak_rss,workdir'
}
