// ============================================================
// 项目级配置 —— 每一个独立运行的项目一份
//
// 只放【本项目相关】的内容：
//   - 输出位置（outdir / workDir）
//   - 样本表 / 比较组表路径
//   - 项目元信息（来自 config.ini 的 [Para] 节）
//
// 【不放】软件与环境、模块资源、调度器 —— 那些归流程侧（pipeline/nextflow.config
// 与 modules/*/config），项目方不需要改动，也不会因为换项目而变。
//
// 运行方式（在本文件所在目录执行，流程本体在 ../pipeline）：
//   nextflow run ../pipeline -profile sge
// Nextflow 会自动合并两份配置：流程目录的 nextflow.config（流程级）
// + 启动目录的 nextflow.config（本文件，项目级），启动目录优先级更高。
// ============================================================

params {
    // 显式输出根目录（绝对路径），最终产物一律 publish 到此处，不落 work/
    outdir     = '/annogene/data1/bioinfo/Seq/RD/PMO/tuchengfang/238/03_Work/10_Project/09_2026/PM-XS01KF2024010282-37/Analysis/results'
    // 样本表 / 比较组表（本项目的三件套之二、之三）
    samples    = 'samples.csv'
    comparison = 'comparison.csv'

    // —— 项目元信息（来自 config.ini [Para]，命令行 --Para_xxx 可覆盖）——
    Para_user         = 'tuchengfang'
    Para_Project      = 'PM-XS01KF2024010282-37'
    Para_ProjectName  = '中农65个小鼠宏基因组建库测序结题报告'
    Para_platform     = 'Illumina'
    Para_ref          = '/annogene/data1/bioinfo/Seq/RD/PMO/tuchengfang/238/03_Work/10_Project/09_2026/PM-XS01KF2024010282-37/ref/GCF_000001635.27_GRCm39_genomic.fna'
    Para_cleandir     = '/annogene/data1/bioinfo/Seq/RD/PMO/tuchengfang/238/03_Work/10_Project/09_2026/PM-XS01KF2024010282-37/Analysis/Analysis/QC/filter/'
    Para_prepare      = '/annogene/data1/bioinfo/Seq/RD/PMO/tuchengfang/238/03_Work/10_Project/09_2026/PM-XS01KF2024010282-37/Analysis/prepare'
    Para_gene_min_len = 200
    Para_cutf         = 30
    Para_samplenum    = 65
}

// Nextflow work 目录（任务暂存区，可 nextflow clean 清理）——与 outdir 分离
workDir = '/annogene/data1/bioinfo/Seq/RD/PMO/tuchengfang/238/03_Work/10_Project/09_2026/PM-XS01KF2024010282-37/Analysis/work'
