// 非容器：集群 miniforge 二进制；改容器则填容器内命令并把对应 *_sif 指向镜像
params {
    sif_dir = "${projectDir}/sif"

    bwa_bin      = '/annogene/data1/bioinfo/Seq/software/miniforge/tuchengfang/miniforge3/bin/bwa'
    samtools_bin = '/annogene/data1/bioinfo/Seq/software/miniforge/tuchengfang/miniforge3/bin/samtools'
    bwa_sif      = ''
    samtools_sif = ''

    // bam_sort_mem 默认 null：sort -m 由 process 按「单 slot 额度×80%」自动推导，
    // 写死会覆盖推导值、重现 bam_mem 分配失败；需要时仅命令行覆盖 --bam_sort_mem
    bam_sort_mem = null
}

env {
    BWA      = params.bwa_bin
    SAMTOOLS = params.samtools_bin
}

process {
    withName: 'MetaSpades_Align' {
        // 对应手工：qsub -pe smp 8 -q micro.q,sci.q,mid.q
        queue          = 'micro.q,sci.q,mid.q'
        penv           = 'smp'
        cpus           = 8
        memory         = '20 GB'
        container      = params.bwa_sif     // 空 = 不启用容器

        // 落点 ${outdir}/metaspades_align/<sample_id>.aln.sort.bam（样本层由文件名承载）
        publishDir = [
            path: { "${params.outdir}/metaspades_align" },
            mode: 'copy'
        ]
    }
}
