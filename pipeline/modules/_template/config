// 模块模板：替换 tool_bin / tool_sif / sort_mem 与 <模块名>、My_Process 后使用
// params 须声明在 process 块之前；executor 不在此写死（会覆盖 -profile local）
params {
    sif_dir  = "${projectDir}/sif"
    tool_bin = '/abs/path/to/tool'   // 非容器：集群绝对路径
    tool_sif = ''                    // 空 = 不启用容器
    sort_mem = '2G'
}

env {
    TOOL = params.tool_bin
}

process {
    withName: 'My_Process' {
        queue     = 'micro.q,sci.q,mid.q'
        penv      = 'smp'              // SGE 并行环境，按 cpus 申请核
        cpus      = 8
        memory    = '20 GB'
        container = params.tool_sif

        // 落点 ${outdir}/<模块名>/<sample_id>.<后缀>
        // ⚠️ config 里 publishDir 只能写 map 列表语法
        publishDir = [
            path: { "${params.outdir}/<模块名>" },
            mode: 'copy'
        ]
    }
}
