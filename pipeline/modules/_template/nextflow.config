// 模块自带配置入口：只有这一行 includeConfig 'config'
// ⚠️ 勿用流程级 pipeline/nextflow.config 覆盖本文件（'modules/<名>/config' 在此目录会解析错，报 Invalid include source）
includeConfig 'config'

// 与流程级 profiles 保持一致，否则单跑模块时 -profile 报 Unknown configuration profile
profiles {
    sge   { process.executor = 'sge' }
    k8s   { process.executor = 'k8s' }
    local { process.executor = 'local' }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    docker {
        docker.enabled = true
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,native_id,name,status,exit,realtime,peak_rss,workdir'
}
