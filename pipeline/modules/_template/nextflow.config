// ============================================================
// 模块 nextflow.config —— 通用注释示例（学习用，非真实步骤）
//
// 本文件只属于【模块目录】，用于让模块在任意目录下单独运行都能加载自身配置。
//
// ⚠ 切勿用流程级的 pipeline/nextflow.config 覆盖它：
//   流程级 config 里的 includeConfig 'modules/<模块>/config' 是从 pipeline/ 出发的相对路径，
//   搬进本目录后会被解析成 modules/<模块>/modules/<模块>/config（不存在），报 Invalid include source。
//
// Nextflow 加载 nextflow.config 的顺序：启动目录 → 脚本所在目录 → $HOME/.nextflow/config
// 本文件位于模块目录，模块单独运行时（nextflow run modules/<模块>/main.nf）会被自动加载，
// 从而 includeConfig 本模块的 config（软件环境 + 默认资源）。
// ============================================================
includeConfig 'config'

// —— 调度 profile ——
// 与流程级 nextflow.config 的 profiles 保持一致；模块单独运行时也能识别 -profile。
profiles {
    sge   { process.executor = 'sge' }
    k8s   { process.executor = 'k8s' }
    local { process.executor = 'local' }

    // —— 容器引擎（按需叠加，逗号组合：-profile sge,singularity）——
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    docker {
        docker.enabled = true
    }
}

// —— 运行报告（模块单独跑时也落盘一份任务级明细）——
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,native_id,name,status,exit,realtime,peak_rss,workdir'
}
