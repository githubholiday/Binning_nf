// 模块级配置：软件环境 + 默认资源。params 须声明在 process 块之前（include 顺序生效）
params {
    sif_dir = "${projectDir}/sif"

    // 非容器：直接用集群 shanzhong 环境的 metaspades（需保证 tuchengfang 可读该路径）
    metaspades_bin = '/annogene/data1/bioinfo/Seq/software/miniforge/shanzhong/miniforge3/envs/metaspades/bin/metaspades.py'

    // 置空 = 关闭容器，走宿主二进制
    metaspades_sif = ''
}

env {
    METASPADES = params.metaspades_bin
}

process {
    withName: 'MetaSpades' {
        // 对应手工：qsub -pe smp 32 -l h_vmem=250G -q micro.q,sci.q
        //   h_vmem 由 memory 自动生成；smp 由 penv 按 cpus 申请，无需写 -l p=N
        queue      = 'micro.q,sci.q'
        penv       = 'smp'
        cpus       = 32            // 原 Makefile threads?=32
        memory     = '250 GB'      // metaSPAdes 内存需求大，按实际样本量调
        container  = params.metaspades_sif

        // 落点 ${outdir}/metaspades/<sample_id>/（sample 层由 process 输出目录名提供，
        // 路径本身不含 sample_id，避免 <模块>/<sample>/<sample> 双层嵌套）
        // ⚠️ config 里 publishDir 只能写 map 列表语法，`publishDir path: ...` 会报 Unexpected input
        publishDir = [
            path: { "${params.outdir}/metaspades" },
            mode: 'copy'
        ]
    }
}
