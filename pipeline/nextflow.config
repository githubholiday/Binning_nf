manifest {
    name = 'metagenome-pipeline'
    // 最低版本声明必须放在 manifest 块内、用【赋值】语法；裸写 `nextflowVersion '...'`
    // 会报 "Unexpected input"。且只能用 ASCII 的 >= —— 经微信/编辑器中转容易被
    // 自动替换成 Unicode 的 ≥（U+2265），同样导致 Config parsing failed。
    nextflowVersion = '>=22.10'
}

// ============================================================
// 流程级配置（流程本体一份，所有项目共用）
//
//   [流程装配]  includeConfig 各模块 config + 生成配置 + profiles
//   [运行环境]  容器引擎设置、调度 profile
//
// 软件与环境参数（sif_dir / metaspades_bin / 各模块镜像路径）由【模块 config】声明，
// includeConfig 时自动合并进本配置——本文件不重复声明，避免同名覆盖顺序歧义。
//
// 注意：本文件【不放】项目级内容（outdir / workDir / 样本表 / 比较组表 / 项目元信息）——
//       那些由每个项目自己的 nextflow.config 提供。
// ============================================================

// —— 流程级默认参数 ——
// 注意：软件与环境参数（sif_dir / metaspades_bin 等）由【各模块 config】声明，
//       下面 includeConfig 各模块时自动合并进流程配置，故此处不重复声明，
//       避免同名覆盖顺序歧义。
params {
    // 样本表/比较组表的默认名（项目级 nextflow.config 会覆盖为项目自己的路径）
    samples    = 'samples.csv'
    comparison = 'comparison.csv'

    // ↓↓↓ 占位：数据根目录（容器内需显式绑定）↓↓↓
    //   autoMounts 只自动绑定 cwd 与 work dir，而 reads 输入是指向该目录下文件的符号链接，
    //   不显式 bind 容器内会报 "No such file or directory"
    //   按你的实际挂载点改；若集群挂载点不止一个，用逗号分隔写多个
    data_root = '/annogene/data1'
}

// —— 各模块配置（模块软件环境 + 默认资源）——
// includeConfig 即合并：模块 config 里声明的 params 会进入流程配置，
// 项目方可用 --sif_dir / --metaspades_bin 或项目级 nextflow.config 覆盖。
// 顺序要求：模块 config 的 params 需在【本文件】include 之前可见，
// 故模块 config 内部把 params 放在文件开头。
includeConfig 'modules/metaspades/config'
includeConfig 'modules/metaspades_align/config'
// 最后 include：覆盖模块默认的资源/调度器（由 pipeline.yaml 生成）
includeConfig 'pipeline.generated.config'

// —— 容器引擎 ——
singularity {
    enabled    = true
    autoMounts = true
    // 显式绑定数据根目录（占位参数见上面的 params.data_root）
    runOptions = "--bind ${params.data_root}"
}

// —— 调度 profile ——
profiles {
    sge   { process.executor = 'sge' }
    k8s   { process.executor = 'k8s' }
    local { process.executor = 'local' }
}

// ============================================================
// 运行报告（每个 run 自动落盘，事后查状态/错误不必翻 .nextflow.log）
//
//   trace.txt  —— 任务级明细：状态、退出码、耗时、峰值内存、workdir
//                 ★ 失败任务的 workdir 直接可见 → tail -40 <workdir>/.command.err
//   report.html —— 时间线视图，浏览器打开看整体进度
//
// trace 字段说明：workdir 是排查错误的关键列（.command.err / .command.out / .command.sh 都在里面）
// overwrite = true：每次 run 覆盖为最新一份；要保留历史可改用带时间戳的 file 名
// ============================================================
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,native_id,name,status,exit,realtime,peak_rss,workdir'
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
